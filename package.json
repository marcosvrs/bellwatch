{
  "name": "bellwatch",
  "version": "0.1.0",
  "private": true,
  "description": "Bellwatch Daft.ie monitor with Shoutrrr notifications",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.alchemy.json",
    "test": "tsx --test \"test/*.test.ts\"",
    "coverage": "c8 npm test",
    "mutation": "stryker run",
    "check": "npm run typecheck && npm run build && npm run coverage",
    "check:changed": "node scripts/changed-validation.mjs",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --no-banner --redact --ignore-gitleaks-allow",
    "scan:secrets:staged": "gitleaks git --staged --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --no-banner --redact --ignore-gitleaks-allow",
    "prepare": "simple-git-hooks",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "alchemy:plan": "alchemy plan",
    "alchemy:deploy": "alchemy deploy",
    "alchemy:destroy": "alchemy destroy"
  },
  "simple-git-hooks": {
    "pre-commit": "git diff --cached --check && npm run scan:secrets:staged && npm run typecheck",
    "pre-push": "npm run scan:secrets && npm run check:changed"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112",
    "playwright": "1.63.0",
    "postgres": "3.4.9",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "24.10.7",
    "alchemy": "2.0.0-beta.77",
    "c8": "^12.0.0",
    "simple-git-hooks": "^2.11.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "alchemy": {
      "@prisma/dev": "0.25.2"
    },
    "qs": "6.16.0"
  }
}
