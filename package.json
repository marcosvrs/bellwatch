{
  "name": "bellwatch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT-0",
  "description": "Bellwatch Daft.ie monitor with Shoutrrr notifications",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test alchemy.run.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.alchemy.json",
    "test": "node scripts/test.mjs",
    "coverage": "c8 npm test",
    "mutation": "stryker run",
    "check": "npm run lint && npm run typecheck && npm run build && npm run coverage",
    "check:changed": "node scripts/changed-validation.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:live": "node scripts/e2e-live.mjs",
    "scan:secrets": "gitleaks git . --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --no-banner --redact --ignore-gitleaks-allow",
    "scan:secrets:staged": "gitleaks git --staged --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --no-banner --redact --ignore-gitleaks-allow",
    "security:deps": "npm audit --audit-level=high && npm audit signatures",
    "security:local": "npm run security:deps && npm run scan:secrets",
    "prepare": "simple-git-hooks",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "alchemy:plan": "alchemy plan",
    "alchemy:deploy": "alchemy deploy",
    "alchemy:destroy": "alchemy destroy"
  },
  "simple-git-hooks": {
    "pre-commit": "git diff --cached --check && npm run scan:secrets:staged && npm run lint && npm run typecheck",
    "pre-push": "npm run scan:secrets && npm run check:changed"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.116",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "26.6.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "alchemy": "2.0.0-beta.79",
    "c8": "^12.0.0",
    "effect": "4.0.0-rc.116",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "redis": "^6.2.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.116",
    "@effect/sql-d1": "4.0.0-rc.116",
    "@effect/sql-sqlite-do": "4.0.0-rc.116",
    "@effect/vitest": "4.0.0-rc.116",
    "alchemy": {
      "@prisma/dev": "0.25.2"
    },
    "qs": "6.16.0"
  }
}
