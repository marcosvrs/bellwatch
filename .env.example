# Copy this file to .env before running docker compose.
# Replace these required secrets before exposing any service beyond localhost.

# The Compose file uses literal non-secret defaults for the stack.
# Keep this password URL-safe because Compose builds DATABASE_URL from it.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
BROWSERLESS_TOKEN=replace-with-a-long-random-browser-token

# Notification service URL. Use any service supported by Shoutrrr.
SHOUTRRR_URL=ntfy://ntfy.sh/replace-with-a-long-random-topic

# To change a non-secret default, edit and uncomment the corresponding
# environment entry in docker-compose.yml.
