# Copy this file to .env before running docker compose.
# Replace these required secrets before exposing any service beyond localhost.

# Compose defaults the database name and user to daft.
# POSTGRES_DB=daft
# POSTGRES_USER=daft
# Keep the Postgres password URL-safe; URL-encode it in a custom DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
BROWSERLESS_TOKEN=replace-with-a-long-random-browser-token

# Notification service URL. Use any service supported by Shoutrrr.
SHOUTRRR_URL=ntfy://ntfy.sh/replace-with-a-long-random-topic

# Optional overrides. Omit these to use the Compose defaults.
# DATABASE_URL=postgresql://user:password@db-host:5432/daft
# REDIS_URL=redis://redis-host:6379/0
# PLAYWRIGHT_WS_ENDPOINT=ws://browserless:3000?token=...
# BROWSER_TIMEOUT_MS=120000
# Compose defaults to listings from the last day, newest first.
# DAFT_ADDED_IN_LAST_DAYS=1
# DAFT_SORT=publishDateDesc
