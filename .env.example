# Copy this file to .env before running docker compose.
# Replace these required secrets before exposing any service beyond localhost.

# The Compose file uses literal non-secret defaults for the stack.
# Keep this password URL-safe because Compose builds DATABASE_URL from it.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
BROWSERLESS_TOKEN=replace-with-a-long-random-browser-token

# Set SHOUTRRR_URL for Shoutrrr, the three required HERMES_* variables
# for Hermes, or both.
SHOUTRRR_URL=ntfy://ntfy.sh/replace-with-a-long-random-topic

# Hermes configuration (uncomment all required variables to enable it; leave
# SHOUTRRR_URL set to send to both backends).
# HERMES_WEBHOOK_URL=http://hermes:8644/webhooks/ha-notify
# HERMES_WEBHOOK_SECRET=replace-with-the-Hermes-webhook-secret
# HERMES_CHAT_ID=replace-with-the-WhatsApp-chat-id

# Optional search overrides:
# DAFT_LOCATION=galway-city
# DAFT_PROPERTY_TYPES=houses
# DAFT_SECTION_PATH=new-homes-for-sale

# Optional scheduling/request pacing overrides:
# TZ=Europe/Dublin
# POLL_CRON=0 */8 * * *
# DAFT_REQUEST_DELAY_MS=1000

# To change a non-secret default, set the corresponding variable here or edit
# the environment entry in docker-compose.yml.
