# Copy this file to .env before running docker compose.
# Replace these required secrets before exposing any service beyond localhost.

# Compose defaults to SQLite in the persistent bellwatch-data volume.
# PostgreSQL remains available for existing state: set both variables and
# run `docker compose --profile postgres up --detach`. The URL password and
# POSTGRES_PASSWORD must match; use a URL-safe password.
# DATABASE_URL=postgresql://daft:replace-me@postgres:5432/daft
# POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
BROWSERLESS_TOKEN=replace-with-a-long-random-browser-token

# Set SHOUTRRR_URL for Shoutrrr, the three required HERMES_* variables
# for Hermes, or both.
SHOUTRRR_URL=ntfy://ntfy.sh/replace-with-a-long-random-topic

# Hermes configuration (uncomment all required variables to enable it; leave
# SHOUTRRR_URL set to send to both backends).
# HERMES_WEBHOOK_URL=http://hermes:8644/webhooks/ha-notify
# HERMES_WEBHOOK_SECRET=replace-with-the-Hermes-webhook-secret
# HERMES_CHAT_ID=replace-with-the-WhatsApp-chat-id

# Optional search overrides:
# DAFT_BASE_URL=https://www.daft.ie
# DAFT_LOCATION=galway-city,dublin
# DAFT_PROPERTY_TYPES=houses
# DAFT_SECTION_PATH=new-homes-for-sale
# For property-for-sale or property-for-rent, set the section path and use
# the profile-specific filters documented in README.md.
# Rental profile: DAFT_SECTION_PATH=property-for-rent
# DAFT_LEASE_LENGTH_MIN_MONTHS=6
# DAFT_LEASE_LENGTH_MAX_MONTHS=12
# DAFT_FURNISHING=furnished
# DAFT_FACILITIES=parking,pets-allowed
# Sale profile: DAFT_SECTION_PATH=property-for-sale
# DAFT_FLOOR_SIZE_MIN_SQM=100
# DAFT_BER_MIN=C
# DAFT_SALE_TYPE=auction
# DAFT_ONLINE_OFFERS=true
# Sale and new-home alerts include current-year sold-price comparisons when
# matching listing fields are available; DAFT_LOCATION scopes those lookups.


# MyHome SSR HTML is enabled by default and uses the configured Daft request delay.
MYHOME_ENABLED=true
# MYHOME_BASE_URL=https://www.myhome.ie

# Optional; searches only when configured. Results stay unverified candidates.
# SEARXNG_BASE_URL=http://searxng:8080

# Optional Baserow mirror for verified provider listings.
# BASEROW_BASE_URL=https://baserow.example
# BASEROW_TOKEN=replace-with-a-Baserow-database-token
# BASEROW_TABLE_ID=listing-table-id
# Required too when both SearXNG and Baserow are enabled:
# BASEROW_CANDIDATE_TABLE_ID=candidate-table-id
# Optional scheduling/request pacing overrides:
# TZ=Europe/Dublin
# POLL_CRON=0 */8 * * *
# DAFT_REQUEST_DELAY_MS=1000

# To change a non-secret default, set the corresponding variable here or edit
# the environment entry in docker-compose.yml.
