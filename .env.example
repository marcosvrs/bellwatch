# Copy this file to .env before running docker compose.
# Replace both placeholder secrets before exposing any service beyond localhost.

BELLWATCH_IMAGE=ghcr.io/marcosvrs/bellwatch:latest

# Compose service credentials. Keep the Postgres password URL-safe, or URL-encode
# it before using a custom DATABASE_URL.
POSTGRES_DB=daft
POSTGRES_USER=daft
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
BROWSERLESS_TOKEN=replace-with-a-long-random-browser-token

# The monitor publishes to the internal ntfy service. The public URL is used by
# the ntfy server for links and host-side access.
NTFY_URL=http://ntfy/bellwatch
NTFY_PUBLIC_URL=http://localhost:8080
NTFY_PORT=8080

# Browserless is localhost-only by default; the monitor uses browserless:3000.
BROWSERLESS_PORT=3000
BROWSERLESS_CONCURRENT=2
BROWSERLESS_QUEUED=4
BROWSERLESS_TIMEOUT_MS=120000

# Monitor defaults. Add or override any variable documented in README.md.
POLL_INTERVAL_SECONDS=900
DAFT_LOCATION_PATH=dublin-city-centre-dublin
DAFT_RADIUS_KM=20
DAFT_PRICE_MAX_EUR=499999
DAFT_BEDS_MIN=3
DAFT_PROPERTY_TYPES=houses
DAFT_MEDIA_TYPES=any
DAFT_AVAILABILITY=published
DAFT_ADDED_IN_LAST_DAYS=0
DAFT_SORT=priceAsc
DAFT_MAX_PAGES=1
